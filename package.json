{
  "name": "speedtest",
  "version": "0.1.0",
  "private": true,
  "description": "Замер скорости скачивания URL из консоли",
  "type": "module",
  "bin": {
    "speedtest": "release/speedtest.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf release && esbuild src/speedtest.ts --bundle --platform=node --format=esm --target=node22 --log-level=warning --outfile=release/speedtest.js",
    "build:smoke": "npm run build && node release/speedtest.js --help > /dev/null",
    "build:test": "rm -rf dist-test && tsc -p tsconfig.json",
    "start": "node release/speedtest.js",
    "test": "npm run build:test && node --test \"dist-test/**/*.test.js\"",
    "test:coverage": "npm run build:test && node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90 --test-coverage-exclude=\"dist-test/**/__tests__/**\" --test-coverage-exclude=\"dist-test/test-utils/**\" \"dist-test/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build:smoke",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
